# Example environment file for Render (DO NOT put secrets here)
# Copy values into the Render dashboard environment variables and set secret values using Render's secret feature.
# Generate APP_KEY locally with: php artisan key:generate --show

# Application
APP_NAME="Bank App"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://laravel-bank-app.onrender.com
# APP_KEY should be set as a secret in Render (do not commit the real key)
APP_KEY=

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=error

# Database (Postgres example)
DB_CONNECTION=pgsql
DB_HOST=ep-steep-feather-adccnsal-pooler.c-2.us-east-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
# DB_PASSWORD should be set as a secret in Render
DB_PASSWORD=
DB_SSLMODE=require

# Cache / Session / Queue
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# Redis (if you migrate to redis in production)
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

# Filesystem
FILESYSTEM_DISK=local
# If using S3, set the following (mark access key/secret as secrets)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Bank App"

# Optional runtime flags
RUN_SEEDERS=false
MAX_RETRIES=10
SLEEP_SECONDS=5

# Monitoring / Error tracking (mark as secret)
SENTRY_DSN=

# Notes:
# - Set APP_KEY, DB_PASSWORD, MAIL_USERNAME, MAIL_PASSWORD, AWS_*, REDIS_PASSWORD, SENTRY_DSN as secrets in Render.
# - If you keep CACHE_DRIVER and SESSION_DRIVER as 'file', ensure the 'disks' entry in render.yaml mounts '/var/www/html/storage'.
# - Render injects a PORT environment variable automatically; the Dockerfile uses ${PORT:-8000}.
